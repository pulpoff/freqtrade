# BotCrypto Engine Configuration
# Copy this file to .env and set your values

# API Server
BC_API_HOST=0.0.0.0
BC_API_PORT=8080
BC_API_USERNAME=freqtrader
BC_API_PASSWORD=your_password_here
BC_JWT_SECRET=change_me_to_something_random

# CORS (comma-separated origins)
BC_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Data directory for strategies, configs, databases
BC_DATA_DIR=user_data

# Log level: DEBUG, INFO, WARNING, ERROR
BC_LOG_LEVEL=INFO
